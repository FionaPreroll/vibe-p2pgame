{
  "name": "@fionapreroll/p2p",
  "version": "0.4.0",
  "description": "Peer-to-peer games for phones in the browser: WebRTC over a shared Wi-Fi or hotspot, paired by QR codes, without internet or servers.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/FionaPreroll/vibe-p2pgame.git",
    "directory": "packages/p2p"
  },
  "exports": {
    ".": "./src/index.ts",
    "./room": "./src/room/index.ts",
    "./qr": "./src/qr/index.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./room": {
        "types": "./dist/room/index.d.ts",
        "default": "./dist/room/index.js"
      },
      "./qr": {
        "types": "./dist/qr/index.d.ts",
        "default": "./dist/qr/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/p2p",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
