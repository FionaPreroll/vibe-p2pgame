{
  "name": "vibe-p2pgame",
  "version": "0.2.0",
  "private": true,
  "description": "A game for phones side by side, in the browser and as an Android app: paired by QR code over Wi-Fi or by Bluetooth, without internet or a server.",
  "author": "FionaPreroll <fipreroll+app@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && pnpm --filter @fionapreroll/p2p --filter @fionapreroll/p2p-nearby typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:coverage": "COVERAGE=1 pnpm test:e2e",
    "screenshots": "pnpm build && playwright test -c playwright.screenshots.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:p2p": "pnpm --filter @fionapreroll/p2p --filter @fionapreroll/p2p-nearby build",
    "icons:android": "node --experimental-strip-types tools/androidIcons.ts",
    "android:sync": "pnpm build && cap sync android"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fionapreroll/p2p": "workspace:^0.3.1",
    "@fionapreroll/p2p-nearby": "workspace:^0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "monocart-coverage-reports": "^3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
